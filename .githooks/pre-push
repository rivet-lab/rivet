#!/usr/bin/env bash
# Pre-push gate: Cargo.lock sync, publish dry-run on a version bump, commit-message rules. CI runs the tests.
# Enable once per clone:  git config core.hooksPath .githooks
set -euo pipefail
. "$(dirname "$0")/repo-venv"

echo "pre-push: cargo metadata --locked"
cargo metadata --locked --format-version 1 > /dev/null

# Release-prep guard: when this branch bumps the crate version vs main, run the
# EXACT publish the release does (`cargo publish --locked --dry-run`). A packaging
# break — a `Cargo.toml` field the spec-strict `cargo-manifest`/`cargo chef`
# parser rejects, an `exclude`d path a build needs, a stale lock — then fails
# HERE, not half-way through the immutable tag's publish (the 0.16.0 / 0.16.1
# failure mode: green `cargo build` + tests, broken `cargo publish`). Gated on a
# version change so ordinary pushes stay fast; skipped when `origin/main` is
# unavailable (CI + release.yml still run `--locked` publish there).
_ver_now="$(grep -m1 '^version = ' Cargo.toml || true)"
_base="$(git merge-base origin/main HEAD 2>/dev/null || true)"
if [ -n "$_base" ]; then
  _ver_base="$(git show "$_base:Cargo.toml" 2>/dev/null | grep -m1 '^version = ' || true)"
  if [ -n "$_ver_now" ] && [ "$_ver_now" != "$_ver_base" ]; then
    echo "pre-push: crate version changed vs main (${_ver_base:-none} -> $_ver_now) — cargo publish --locked --dry-run"
    cargo publish --locked --dry-run
  fi
fi

# Every commit leaving the machine: English, no attribution trailer, no closing keyword before #N.
if _mb="$(git merge-base origin/main HEAD 2>/dev/null)"; then
  echo "pre-push: commit message rules"
  python3 dev/pytools/pr_ready.py text --commits "$_mb..HEAD"
fi

echo "pre-push: ok"
